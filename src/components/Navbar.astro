        <ul class="lang-menu" data-lang-menu role="listbox" aria-label="Language">
          <li role="option" data-lang-option="en">English</li>
          <li role="option" data-lang-option="ur">اردو</li>
          <li role="option" data-lang-option="ar">العربية</li>
