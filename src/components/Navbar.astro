  <!-- mobile card dropdown -->
  <div class="nav-mobile-content" id="navMobileContent">
    <div class="nav-card" style="background:rgba(255,255,255,0.05); color:#fff; gap:0;">
      <div class="nav-card-links" style="margin-bottom:18px;">
        <a class="nav-card-link" href="#hero" data-i18n="nav.home">Home</a>
