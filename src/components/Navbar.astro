        <button type="button" class="lang-trigger glow-btn glow-btn-primary" data-lang-trigger aria-haspopup="listbox" aria-expanded="false" aria-label="Select language">
          <div class="edge-light"></div>
          <i class="ti ti-world language-icon" aria-hidden="true"></i>
          <span class="lang-code" data-lang-code>EN</span>
