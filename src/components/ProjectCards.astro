---

<section class="projects" id="work">
  <div class="section-title-row">
    <span class="circuit-rail"><span class="circuit-pulse"></span></span>
    <h2 class="section-title">
      <span class="st-bracket">&lt;</span><span data-i18n="projects.sectionTitle">My&nbsp;Projects</span><span class="st-bracket"> /&gt;</span>
    </h2>
    <span class="circuit-rail"><span class="circuit-pulse circuit-pulse-rev"></span></span>
  </div>

  <div class="grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</section>

<style>
  .projects {
    position: relative;
    z-index: 2;
    background: #000;
    padding: 4rem 1rem;
  }

  /* ===== Section title: <My Projects /> with animated circuit rails ===== */
  .section-title-row {
    display: flex;
    align-items: center;
    gap: 18px;
    max-width: 900px;
    margin: 0 auto 2.5rem;
    padding: 1rem 2rem 1.2rem 16px;
  }

  .section-title {
    flex: 0 0 auto;
    margin: 0;
    font-family: 'Share Tech Mono', monospace;
    font-weight: 700;
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    background: linear-gradient(135deg, #d946ef, #ec4899, #06b6d4, #22c55e, #eab308, #ec4899, #d946ef);
    background-size: 300% 300%;
    animation: gradientMove 4s ease infinite;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .st-bracket {
    -webkit-text-fill-color: #22c55e;
    color: #22c55e;
    text-shadow: 0 0 8px rgba(34, 197, 94, 0.6);
  }

  .circuit-rail {
    position: relative;
    flex: 1 1 auto;
    height: 30px;
    min-width: 24px;
    overflow: hidden;
  }

  .circuit-rail::before {
    content: '';
    position: absolute;
    top: 50%; left: 0; right: 0;
    height: 1.5px;
    transform: translateY(-50%);
    background: repeating-linear-gradient(
      90deg,
      rgba(255,255,255,0.35) 0 5px,
      transparent 5px 11px
    );
    background-size: 22px 100%;
    animation: circuitDash 1.1s linear infinite;
  }

  .circuit-rail::after {
    content: '';
    position: absolute;
    top: 50%; left: 0;
    width: 5px; height: 5px;
    border-radius: 50%;
    transform: translate(-1px, -50%);
    background: #06b6d4;
    box-shadow: 0 0 6px #06b6d4, 0 0 6px #06b6d4;
  }
  .section-title-row .circuit-rail:last-child::after {
    left: auto; right: 0;
    transform: translate(1px, -50%);
    background: #ec4899;
    box-shadow: 0 0 6px #ec4899, 0 0 6px #ec4899;
  }

  @keyframes circuitDash {
    to { background-position: -22px 0; }
  }

  .circuit-pulse {
    position: absolute;
    top: 50%; left: 0;
    width: 10px; height: 10px;
    margin-top: -5px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffffff 0%, #06b6d4 55%, transparent 75%);
    box-shadow: 0 0 8px 2px #06b6d4, 0 0 16px 4px rgba(6,182,212,0.5);
    animation: pulseTravel 2.4s ease-in-out infinite;
  }
  .circuit-pulse-rev {
    background: radial-gradient(circle, #ffffff 0%, #ec4899 55%, transparent 75%);
    box-shadow: 0 0 8px 2px #ec4899, 0 0 16px 4px rgba(236,72,153,0.5);
    animation: pulseTravelRev 2.4s ease-in-out infinite;
    animation-delay: 0.3s;
  }

  @keyframes pulseTravel {
    0%   { left: 0%;   opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  @keyframes pulseTravelRev {
    0%   { left: 100%; opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { left: 0%;   opacity: 0; }
  }

  .grid {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  import { initGlowButtons } from '../scripts/glow-btn';
  initGlowButtons();

  // Delegated listener: open a project's modal on "View in Terminal",
  // close it via the X button or a backdrop click, switch between the
  // project.exe / analysis.exe tabs inside an open modal, and Escape to close.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    // Open modal
    const openBtn = target.closest<HTMLElement>('.view-terminal');
    if (openBtn) {
      const modal = document.getElementById(openBtn.dataset.modal ?? '');
      if (modal) {
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
      return;
    }

    // Close modal — X button or a click on the dark backdrop itself
    const closeBtn = target.closest<HTMLElement>('.modal-close');
    const overlay = target.closest<HTMLElement>('.tc-modal-overlay');
    if (closeBtn || (overlay && target === overlay)) {
      const openOverlay = closeBtn?.closest<HTMLElement>('.tc-modal-overlay') ?? overlay;
      openOverlay?.classList.remove('open');
      document.body.style.overflow = '';
      return;
    }

    // Tab switch inside an open modal (project.exe <-> analysis.exe)
    const tab = target.closest<HTMLElement>('.tc-modal-tab');
    if (tab) {
      const modal = tab.closest<HTMLElement>('.tc-modal');
      const paneId = tab.dataset.modalPane;
      if (!modal || !paneId) return;

      modal.querySelectorAll<HTMLElement>('.tc-modal-tab').forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      modal.querySelectorAll<HTMLElement>('.mpane').forEach((pane) => pane.classList.remove('show'));
      modal.querySelector<HTMLElement>(`#${paneId}`)?.classList.add('show');
      return;
    }

    // Photo carousel: prev / next arrows and dot navigation
    const carousel = target.closest<HTMLElement>('[data-carousel]');
    if (carousel) {
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.carousel-slide'));
      const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.carousel-dot'));
      if (slides.length === 0) return;

      const currentIndex = slides.findIndex((s) => s.classList.contains('active'));
      let nextIndex = currentIndex;

      if (target.closest('.carousel-next')) {
        nextIndex = (currentIndex + 1) % slides.length;
      } else if (target.closest('.carousel-prev')) {
        nextIndex = (currentIndex - 1 + slides.length) % slides.length;
      } else {
        const dot = target.closest<HTMLElement>('.carousel-dot');
        if (dot) nextIndex = Number(dot.dataset.index ?? currentIndex);
        else return;
      }

      slides.forEach((s, i) => s.classList.toggle('active', i === nextIndex));
      dots.forEach((d, i) => d.classList.toggle('active', i === nextIndex));
      return;
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLElement>('.tc-modal-overlay.open').forEach((m) => {
      m.classList.remove('open');
    });
    document.body.style.overflow = '';
  });
</script>