---
export interface Props {
  /** Exactly 7 hex colors used as gradient stops along the beam. */
  colors?: string[];
  /** CSS height of the beam's container. Defaults to 100% (fills parent). */
  height?: string;
  /** Extra class name(s) applied to the wrapping element. */
  className?: string;
  /** How fast the beam undulates. */
  speed?: number;
  /** Vertical amplitude of the wave, in normalized (0–1) units. */
  amplitude?: number;
  /** Overall brightness multiplier. */
  intensity?: number;
}

const {
  colors = [
    "#d946ef",
    "#ec4899",
    "#06b6d4",
    "#22c55e",
    "#eab308",
    "#ec4899",
    "#d946ef",
  ],
  height = "100%",
  className = "",
  speed = 0.35,
  amplitude = 0.16,
  intensity = 1.1,
} = Astro.props;

const config = JSON.stringify({ colors, speed, amplitude, intensity });
---

<div class:list={["line-beam", className]} style={`--lb-height:${height}`}>
  <canvas class="line-beam__canvas" data-line-beam data-config={config}></canvas>
</div>

<style>
  .line-beam {
    position: absolute;
    inset: 0;
    width: 100%;
    height: var(--lb-height);
    pointer-events: none;
    overflow: hidden;
  }

  .line-beam__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  type BeamConfig = {
    colors: string[];
    speed: number;
    amplitude: number;
    intensity: number;
  };

  const DEFAULT_COLORS = [
    "#d946ef",
    "#ec4899",
    "#06b6d4",
    "#22c55e",
    "#eab308",
    "#ec4899",
    "#d946ef",
  ];

  function hexToRgb(hex: string): [number, number, number] {
    const clean = hex.replace("#", "");
    const full =
      clean.length === 3
        ? clean
            .split("")
            .map((c) => c + c)
            .join("")
        : clean;
    const value = parseInt(full, 16);
    return [
      ((value >> 16) & 255) / 255,
      ((value >> 8) & 255) / 255,
      (value & 255) / 255,
    ];
  }

  const VERTEX_SHADER = `
    attribute vec2 a_position;
    varying vec2 vUv;
    void main() {
      vUv = a_position * 0.5 + 0.5;
      gl_Position = vec4(a_position, 0.0, 1.0);
    }
  `;

  const FRAGMENT_SHADER = `
    precision highp float;
    varying vec2 vUv;

    uniform vec2 u_resolution;
    uniform float u_time;
    uniform float u_speed;
    uniform float u_amplitude;
    uniform float u_intensity;

    uniform vec3 u_c0;
    uniform vec3 u_c1;
    uniform vec3 u_c2;
    uniform vec3 u_c3;
    uniform vec3 u_c4;
    uniform vec3 u_c5;
    uniform vec3 u_c6;

    vec3 gradient(float t) {
      float s = clamp(t, 0.0, 1.0) * 6.0;
      float i = floor(s);
      float f = smoothstep(0.0, 1.0, fract(s));
      if (i < 1.0) return mix(u_c0, u_c1, f);
      if (i < 2.0) return mix(u_c1, u_c2, f);
      if (i < 3.0) return mix(u_c2, u_c3, f);
      if (i < 4.0) return mix(u_c3, u_c4, f);
      if (i < 5.0) return mix(u_c4, u_c5, f);
      return mix(u_c5, u_c6, f);
    }

    float curve(float x, float t) {
      float y = 0.46;
      y += u_amplitude * sin(x * 3.1 + t * u_speed);
      y += u_amplitude * 0.38 * sin(x * 6.4 - t * u_speed * 0.7 + 1.3);
      return y;
    }

    void main() {
      vec2 uv = vUv;
      vec2 px = uv * u_resolution;

      float curveYn = curve(uv.x, u_time);
      float curveYpx = curveYn * u_resolution.y;
      float d = abs(px.y - curveYpx);

      float coreSigma = max(1.4, u_resolution.y * 0.0032);
      float glowSigma = max(18.0, u_resolution.y * 0.05);

      float core = exp(-(d * d) / (2.0 * coreSigma * coreSigma));
      float glow = exp(-(d * d) / (2.0 * glowSigma * glowSigma)) * 0.55;
      float line = core + glow;

      float pulsePos = fract(u_time * 0.05);
      float pulseDist = abs(uv.x - pulsePos);
      pulseDist = min(pulseDist, 1.0 - pulseDist);
      float pulse = exp(-pow(pulseDist * 5.0, 2.0));
      line += pulse * core * 1.4;

      vec3 col = gradient(uv.x);
      float centerFade = 1.0 - smoothstep(0.0, 0.6, abs(uv.x - 0.5));
      col = mix(col, vec3(1.0), centerFade * 0.8 + pulse * 0.4);

      vec3 finalColor = col * line * u_intensity;
      float alpha = clamp(line * u_intensity, 0.0, 1.0);

      gl_FragColor = vec4(finalColor * alpha, alpha);
    }
  `;

  function compileShader(
    gl: WebGLRenderingContext,
    type: number,
    source: string,
  ): WebGLShader {
    const shader = gl.createShader(type);
    if (!shader) throw new Error("Unable to create shader");
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      const info = gl.getShaderInfoLog(shader);
      gl.deleteShader(shader);
      throw new Error(`Shader compile error: ${info}`);
    }
    return shader;
  }

  function initBeam(canvas: HTMLCanvasElement) {
    const raw = canvas.dataset.config;
    const config: BeamConfig = raw
      ? JSON.parse(raw)
      : { colors: DEFAULT_COLORS, speed: 0.35, amplitude: 0.16, intensity: 1.1 };

    const gl = (canvas.getContext("webgl") ||
      canvas.getContext("experimental-webgl")) as WebGLRenderingContext | null;
    if (!gl) return;

    const vertShader = compileShader(gl, gl.VERTEX_SHADER, VERTEX_SHADER);
    const fragShader = compileShader(gl, gl.FRAGMENT_SHADER, FRAGMENT_SHADER);

    const program = gl.createProgram();
    if (!program) throw new Error("Unable to create program");
    gl.attachShader(program, vertShader);
    gl.attachShader(program, fragShader);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      throw new Error(`Program link error: ${gl.getProgramInfoLog(program)}`);
    }
    gl.useProgram(program);

    const quad = new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]);
    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.bufferData(gl.ARRAY_BUFFER, quad, gl.STATIC_DRAW);

    const posLoc = gl.getAttribLocation(program, "a_position");
    gl.enableVertexAttribArray(posLoc);
    gl.vertexAttribPointer(posLoc, 2, gl.FLOAT, false, 0, 0);

    const uResolution = gl.getUniformLocation(program, "u_resolution");
    const uTime = gl.getUniformLocation(program, "u_time");
    const uSpeed = gl.getUniformLocation(program, "u_speed");
    const uAmplitude = gl.getUniformLocation(program, "u_amplitude");
    const uIntensity = gl.getUniformLocation(program, "u_intensity");
    const colorUniforms = ["u_c0", "u_c1", "u_c2", "u_c3", "u_c4", "u_c5", "u_c6"].map(
      (name) => gl.getUniformLocation(program, name),
    );

    const colors = (
      config.colors && config.colors.length === 7 ? config.colors : DEFAULT_COLORS
    ).map(hexToRgb);

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let width = 0;
    let height = 0;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const w = Math.max(1, Math.floor(rect.width * dpr));
      const h = Math.max(1, Math.floor(rect.height * dpr));
      if (w !== width || h !== height) {
        width = w;
        height = h;
        canvas.width = width;
        canvas.height = height;
        gl!.viewport(0, 0, width, height);
      }
    }

    const ro = new ResizeObserver(resize);
    ro.observe(canvas);
    resize();

    let visible = true;
    const io = new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? true;
      },
      { threshold: 0 },
    );
    io.observe(canvas);

    let start = performance.now();
    let elapsed = 0;

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) return;
      start = performance.now() - elapsed;
    });

    let raf = 0;

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      if (!visible) return;

      elapsed = now - start;
      const t = reducedMotion ? 0 : elapsed / 1000;

      gl!.uniform2f(uResolution, width, height);
      gl!.uniform1f(uTime, t);
      gl!.uniform1f(uSpeed, config.speed ?? 0.35);
      gl!.uniform1f(uAmplitude, config.amplitude ?? 0.16);
      gl!.uniform1f(uIntensity, config.intensity ?? 1.1);
      colors.forEach((c, i) => gl!.uniform3f(colorUniforms[i], c[0], c[1], c[2]));

      gl!.clearColor(0, 0, 0, 0);
      gl!.clear(gl!.COLOR_BUFFER_BIT);
      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);

      if (reducedMotion) {
        cancelAnimationFrame(raf);
      }
    }

    raf = requestAnimationFrame(frame);
  }

  function initAll() {
    document
      .querySelectorAll<HTMLCanvasElement>("canvas[data-line-beam]")
      .forEach((canvas) => {
        if (canvas.dataset.lbInit) return;
        canvas.dataset.lbInit = "true";
        initBeam(canvas);
      });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll);
  } else {
    initAll();
  }

  document.addEventListener("astro:page-load", initAll);
</script>
